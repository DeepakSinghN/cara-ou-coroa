---
interface Props {
  currentPage: string;
}

const { currentPage } = Astro.props;
---

<nav aria-label="Navegação estrutural (Breadcrumb)" class="mb-4">
  <ol class="inline-flex items-center justify-center gap-2 text-xs list-none p-0 m-0">
    <li>
      <a
        href="/"
        class="text-white/70 hover:text-white transition-colors inline-flex items-center gap-1.5 no-underline font-medium"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="opacity-80">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Início
      </a>
    </li>
    <li class="text-white/35 select-none" aria-hidden="true">/</li>
    <li class="text-primary-dark font-semibold truncate max-w-[260px]" aria-current="page">
      {currentPage}
    </li>
  </ol>
</nav>
