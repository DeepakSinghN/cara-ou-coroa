---
// CoinApp — Aplicativo interativo cara ou coroa
// Sem persistência de dados — todo estado é apenas de sessão (em memória)
---

<section
  id="cara-ou-coroa"
  class="bg-canvas text-ink dark:bg-surface-black dark:text-on-dark min-h-[100svh] flex items-center transition-colors duration-300"
  aria-label="Cara ou coroa virtual — jogo online"
>
  <div class="container-content w-full py-2">
    <!-- Título Principal (H1 SEO Otimizado) -->
    <div class="text-center mb-2">
      <h1
        id="app-eyebrow"
        class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-ink dark:text-on-dark mb-1.5"
      >
        Cara ou Coroa — Jogo da Moeda Virtual Online
      </h1>
      <p class="text-lead text-ink-muted dark:text-body-muted m-0 text-sm sm:text-base max-w-[580px] mx-auto">
        Grátis, instantâneo e 100% justo. Clique na moeda ou aperte Espaço para lançar.
      </p>
    </div>

    <!-- Main layout: coin centered, stats shifted right on desktop -->
    <div
      id="app-layout"
      class="relative flex flex-col lg:flex-row items-center lg:items-start justify-center gap-8 lg:gap-10 mt-4 w-full min-h-[460px]"
    >
      <!-- CENTER: Coin + Controls (Dead-centered in desktop layout) -->
      <div
        class="flex flex-col items-center gap-6 w-full max-w-[500px] flex-none"
      >
        <!-- Linha de seletor: apenas estilo de animação acima da moeda -->
        <div class="flex flex-col items-center gap-1.5 justify-center">
          <div class="flex items-center gap-1.5">
            <label
              for="anim-style-select"
              class="text-sm text-ink-muted dark:text-body-muted font-normal"
              >Animação:</label
            >
            <select
              id="anim-style-select"
              class="bg-parchment text-ink border border-hairline dark:bg-white/8 dark:text-on-dark dark:border-white/15 rounded-sm px-3 py-1.5 text-sm cursor-pointer outline-none font-medium text-amber-600 dark:text-amber-400"
            >
              <option value="popout" selected>👓 3D Pop-Out</option>
              <option value="jackpot">🎰 Jackpot 5000 RPM</option>
              <option value="mario">🍄 Super Mario</option>
              <option value="jelly">🍮 Jelly Slime</option>
              <option value="classic">🪙 Clássico</option>
            </select>
          </div>
          <p class="text-[11px] text-ink-faint/80 dark:text-body-muted/70 m-0 text-center">
            ✨ Mais estilos de animação serão adicionados em breve!
          </p>
        </div>

        <!-- Área de exibição das moedas -->
        <div
          id="coins-container"
          class="style-popout flex flex-wrap gap-4 justify-center items-center min-h-[200px]"
        >
          <!-- Moeda única por padrão -->
          <div class="coin-wrapper" id="coin-0">
            <div
              class="coin"
              id="single-coin"
              role="button"
              tabindex="0"
              aria-label="Moeda — clique ou pressione Espaço para lançar"
              title="Clique para lançar!"
            >
              <div class="coin-edge-ring"></div>
              <div
                class="coin-face coin-face-front"
                id="coin-0-front"
                aria-hidden="true"
              >
                <div class="text-center leading-tight">
                  <div id="heads-label-display" class="text-xl font-bold">
                    C
                  </div>
                  <div
                    class="text-[11px] font-normal opacity-70 mt-0.5"
                    id="heads-sublabel"
                  >
                    CARA
                  </div>
                </div>
              </div>
              <div
                class="coin-face coin-face-back"
                id="coin-0-back"
                aria-hidden="true"
              >
                <div class="text-center leading-tight">
                  <div id="tails-label-display" class="text-xl font-bold">
                    K
                  </div>
                  <div
                    class="text-[11px] font-normal opacity-70 mt-0.5"
                    id="tails-sublabel"
                  >
                    COROA
                  </div>
                </div>
              </div>
            </div>
            <div class="coin-shadow" id="coin-0-shadow"></div>
          </div>
        </div>

        <!-- Seletor de modo de jogo (abaixo da moeda) -->
        <div class="flex items-center gap-2 justify-center">
          <label
            for="bestof-select"
            class="text-sm text-ink-muted dark:text-body-muted font-normal"
            >Modo de jogo:</label
          >
          <select
            id="bestof-select"
            class="bg-parchment text-ink border border-hairline dark:bg-white/8 dark:text-on-dark dark:border-white/15 rounded-sm px-3 py-1.5 text-sm cursor-pointer outline-none"
          >
            <option value="0">Lance livre</option>
            <option value="3">Melhor de 3</option>
            <option value="5">Melhor de 5</option>
            <option value="7">Melhor de 7</option>
          </select>
        </div>

        <!-- Placar Melhor de X (exibido abaixo da moeda quando o modo de jogo está ativo) -->
        <div
          id="bestof-score-container"
          class="hidden bg-parchment/90 dark:bg-white/8 border border-hairline dark:border-white/15 rounded-full px-5 py-2 my-1 text-center transition-all duration-300 shadow-sm"
        >
          <div class="flex items-center gap-3">
            <span
              class="text-[11px] font-bold text-primary dark:text-primary-dark uppercase tracking-wider"
              id="bestof-label">Melhor de 3</span
            >
            <span class="text-ink-faint/30 dark:text-white/20">|</span>
            <div class="flex items-center gap-1.5">
              <span
                class="text-xs font-semibold text-ink-muted dark:text-body-muted"
                id="bestof-heads-name">Cara</span
              >
              <span
                id="bestof-heads-wins"
                class="text-base font-bold text-[#b8860b] dark:text-[#d4a017]"
                >0</span
              >
            </div>
            <span class="text-xs text-ink-faint dark:text-white/40 font-bold"
              >:</span
            >
            <div class="flex items-center gap-1.5">
              <span
                id="bestof-tails-wins"
                class="text-base font-bold text-[#707070] dark:text-[#9a9a9a]"
                >0</span
              >
              <span
                class="text-xs font-semibold text-ink-muted dark:text-body-muted"
                id="bestof-tails-name">Coroa</span
              >
            </div>
          </div>
        </div>

        <!-- Anúncio do resultado sob a moeda -->
        <div
          id="result-announcement"
          aria-live="polite"
          aria-atomic="true"
          class="min-h-[36px] text-center"
        >
          <p
            id="result-text"
            class="text-lg font-bold text-ink dark:text-on-dark m-0 opacity-0 transition-opacity duration-300 tracking-[0.231px]"
          >
          </p>
          <p
            id="result-sub"
            class="text-xs text-ink-faint dark:text-body-muted mb-0 opacity-0 transition-opacity duration-300"
          >
          </p>
        </div>

        <!-- Botão principal de lançamento + controles -->
        <div class="flex items-center gap-3 flex-wrap justify-center">
          <button
            id="flip-btn"
            class="btn-primary px-9 py-3.5 text-lg font-medium shadow-md hover:shadow-lg transition-shadow"
            aria-label="Lançar moeda"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              class="shrink-0"
            >
              <path d="M1 4v6h6M23 20v-6h-6"></path>
              <path
                d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4-4.64 4.36A9 9 0 0 1 3.51 15"
              ></path>
            </svg>
            Jogar a moeda!
          </button>

          <button
            id="reset-btn"
            class="btn-ghost px-5 py-3.5 text-sm border-hairline text-ink-muted hover:border-ink hover:text-ink dark:border-white/25 dark:text-white/70 dark:hover:border-white/50 dark:hover:text-white"
            aria-label="Reiniciar estatísticas"
          >
            Reiniciar
          </button>

          <button
            id="sound-btn"
            class="btn-icon bg-black/5 text-ink-muted hover:bg-black/10 hover:text-ink dark:bg-white/10 dark:text-white/70 dark:hover:bg-white/20 dark:hover:text-white"
            aria-label="Alternar som"
            title="Alternar som"
          >
            <svg
              id="sound-on-icon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path
                d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"
              ></path>
            </svg>
            <svg
              id="sound-off-icon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              class="hidden"
            >
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <line x1="23" y1="9" x2="17" y2="15"></line><line
                x1="17"
                y1="9"
                x2="23"
                y2="15"></line>
            </svg>
          </button>

          <!-- Personalizar rótulos -->
          <button
            id="customize-btn"
            class="btn-icon bg-black/5 text-ink-muted hover:bg-black/10 hover:text-ink dark:bg-white/10 dark:text-white/70 dark:hover:bg-white/20 dark:hover:text-white"
            aria-label="Personalizar rótulos da moeda"
            title="Personalizar rótulos"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
              ></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
              ></path>
            </svg>
          </button>
        </div>

        <!-- Dica de atalho do teclado -->
        <p class="text-xs text-ink-faint dark:text-white/70 m-0 text-center">
          Pressione <kbd
            class="bg-black/10 text-ink dark:bg-white/15 dark:text-white px-1.5 py-0.5 rounded font-mono"
            >Espaço</kbd
          > para lançar &nbsp;·&nbsp;
          <kbd
            class="bg-black/10 text-ink dark:bg-white/15 dark:text-white px-1.5 py-0.5 rounded font-mono"
            >R</kbd
          > para reiniciar
        </p>
      </div>

      <!-- RIGHT: Live Winner Showcase + Stats Panel (Option A) -->
      <div
        id="stats-panel"
        class="flex-none w-full sm:w-[320px] max-w-full sm:max-w-[340px] lg:w-[330px] mt-8 lg:mt-0"
      >
        <div
          class="bg-parchment/90 dark:bg-white/6 border border-hairline dark:border-white/10 rounded-2xl p-5 shadow-xl space-y-4 transition-all"
        >
          <!-- 1. Live Winner Showcase Header Card -->
          <div
            id="winner-showcase"
            class="winner-showcase-ready rounded-xl p-4 border text-center transition-all duration-300"
          >
            <!-- Ready State -->
            <div
              id="showcase-ready-state"
              class="flex flex-col items-center gap-1.5 py-1"
            >
              <span
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-black/5 dark:bg-white/10 text-ink-muted dark:text-white/80"
              >
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
                ></span>
                Pronto para lançar
              </span>
              <p class="text-xs text-ink-faint dark:text-body-muted m-0 mt-1">
                Toque na moeda ou clique no botão
              </p>
            </div>

            <!-- Winner State (Shown on result) -->
            <div
              id="showcase-winner-state"
              class="hidden flex-col items-center text-center"
            >
              <div
                id="winner-badge-pill"
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold tracking-wider uppercase mb-1 shadow-sm"
              >
                <span id="winner-icon">👑</span>
                <span id="winner-badge-text">Vencedor</span>
              </div>
              <h3
                id="winner-title"
                class="text-2xl font-black tracking-tight my-0.5 text-ink dark:text-on-dark"
              >
                CARA
              </h3>
              <p
                id="winner-sub"
                class="text-xs font-medium opacity-85 m-0 text-ink-muted dark:text-white/80"
              >
                Caiu em Cara!
              </p>
            </div>
          </div>

          <!-- 2. Streak Flame Indicator (Hot streak >= 2) -->
          <div
            id="streak-banner"
            class="hidden items-center justify-between px-3.5 py-2 rounded-lg bg-amber-500/10 border border-amber-500/25 text-amber-700 dark:text-amber-300 text-xs font-semibold"
          >
            <div class="flex items-center gap-1.5">
              <span>🔥</span>
              <span id="streak-banner-text">3x Seguidas de Cara!</span>
            </div>
            <span
              class="text-[10px] uppercase tracking-wider font-extrabold opacity-80"
              >Em Alta</span
            >
          </div>

          <!-- 3. Head-to-Head Ratio Battle Bar -->
          <div class="space-y-2 pt-1">
            <div class="flex justify-between items-center text-xs">
              <span
                class="font-bold text-[#b8860b] dark:text-[#f5ce60] flex items-center gap-1.5"
              >
                <span
                  class="w-2.5 h-2.5 rounded-full bg-[#d4a017] shadow-sm inline-block"
                ></span>
                <span id="stat-heads-name">Cara</span>
                <span class="font-semibold text-ink dark:text-on-dark ml-0.5"
                  ><span id="stat-heads">0</span> (<span id="stat-heads-pct"
                    >0</span
                  >%)</span
                >
              </span>
              <span
                class="text-[10px] font-black uppercase tracking-widest text-ink-faint dark:text-white/40 px-1.5 py-0.5 rounded bg-black/5 dark:bg-white/10"
                >VS</span
              >
              <span
                class="font-bold text-[#555e6d] dark:text-[#b5bcc7] flex items-center gap-1.5"
              >
                <span class="font-semibold text-ink dark:text-on-dark mr-0.5"
                  >(<span id="stat-tails-pct">0</span>%) <span id="stat-tails"
                    >0</span
                  ></span
                >
                <span id="stat-tails-name">Coroa</span>
                <span
                  class="w-2.5 h-2.5 rounded-full bg-[#8f96a3] shadow-sm inline-block"
                ></span>
              </span>
            </div>

            <!-- Unified Dual Split Bar -->
            <div
              class="h-3 w-full bg-black/10 dark:bg-white/10 rounded-full overflow-hidden flex p-0.5 gap-0.5"
            >
              <div
                id="bar-heads"
                class="h-full rounded-l-full bg-gradient-to-r from-[#e5ad19] to-[#ffd700] transition-all duration-500"
                style="width: 50%;"
              >
              </div>
              <div
                id="bar-tails"
                class="h-full rounded-r-full bg-gradient-to-r from-[#97a0ad] to-[#cbd2dc] transition-all duration-500"
                style="width: 50%;"
              >
              </div>
            </div>

            <div
              class="flex justify-between items-center text-[11px] text-ink-faint dark:text-body-muted pt-0.5"
            >
              <span
                >Total: <strong
                  id="stat-total"
                  class="text-ink dark:text-on-dark font-semibold">0</strong
                ></span
              >
              <span id="stat-longest-display" class="text-[11px]"
                >Recorde: <strong>—</strong></span
              >
            </div>
          </div>

          <!-- 4. Mini Minted History Stream -->
          <div
            class="border-t border-hairline dark:border-white/10 pt-3.5 space-y-2"
          >
            <div class="flex items-center justify-between">
              <span
                class="text-xs font-semibold text-ink-faint dark:text-white/80 uppercase tracking-wider"
                >Histórico Recente</span
              >
              <span
                id="history-count"
                class="text-[11px] text-ink-faint dark:text-body-muted font-medium"
              ></span>
            </div>
            <div
              id="history-stream"
              class="flex flex-wrap gap-1.5 min-h-[30px] items-center"
              role="region"
              aria-live="polite"
              aria-label="Histórico de lançamentos"
            >
            </div>
            <p
              id="history-empty"
              class="text-xs text-ink-faint dark:text-white/60 m-0 italic py-1"
            >
              Nenhum lançamento ainda — jogue a moeda!
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Modal de Personalização de Rótulos -->
<div
  id="customize-modal"
  class="modal-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="customize-modal-title"
>
  <div class="modal-card">
    <h3
      id="customize-modal-title"
      class="text-xl font-semibold mb-2 mt-0 text-ink"
    >
      Personalizar sua Moeda
    </h3>
    <p class="text-sm text-ink-faint mb-6 mt-0">
      Substitua Cara/Coroa pelos seus próprios rótulos de decisão.
    </p>
    <div class="flex flex-col gap-3 mb-6">
      <div>
        <label
          for="custom-heads"
          class="block text-sm font-semibold mb-1 text-ink">Lado Cara</label
        >
        <input
          id="custom-heads"
          type="text"
          placeholder="ex. Pizza"
          maxlength="12"
          class="w-full px-3.5 py-2.5 border border-hairline rounded-sm text-base bg-parchment text-ink outline-none box-border"
        />
      </div>
      <div>
        <label
          for="custom-tails"
          class="block text-sm font-semibold mb-1 text-ink">Lado Coroa</label
        >
        <input
          id="custom-tails"
          type="text"
          placeholder="ex. Sushi"
          maxlength="12"
          class="w-full px-3.5 py-2.5 border border-hairline rounded-sm text-base bg-parchment text-ink outline-none box-border"
        />
      </div>
    </div>
    <div class="flex gap-2.5 justify-end">
      <button id="customize-cancel" class="btn-ghost text-sm px-4.5 py-2.5"
        >Cancelar</button
      >
      <button id="customize-save" class="btn-primary text-sm px-4.5 py-2.5"
        >Aplicar</button
      >
    </div>
  </div>
</div>

<script>
  // ============================================================
  // COIN FLIP APP — Session-only state (no localStorage)
  // ============================================================

  // ---------- State ----------
  const state = {
    headsLabel: "Cara",
    tailsLabel: "Coroa",
    coinCount: 1,
    isFlipping: false,
    soundEnabled: true,
    bestofN: 0, // 0 = free flip, 3/5/7 = best-of
    animStyle: "popout", // 'popout' = 3D Toward Screen, 'jackpot' = Arcade, 'mario' = Retro, 'jelly' = Slime, 'classic' = Classic
    // Session stats (reset on page refresh — no persistence by design)
    totalFlips: 0,
    headsCount: 0,
    tailsCount: 0,
    currentStreak: { side: "", count: 0 },
    longestStreak: { side: "", count: 0 },
    history: [] as string[], // 'H' or 'T'
    bestofHeadsWins: 0,
    bestofTailsWins: 0,
    bestofActive: false,
  };

  // ---------- Audio — real coin-toss MP3 ----------
  // Preload on first user interaction; rewind and replay on every flip.
  const coinAudio = new Audio("/coin-toss-sound.mp3");
  coinAudio.preload = "auto";

  function playFlipSound() {
    if (!state.soundEnabled) return;
    try {
      coinAudio.currentTime = 0;
      coinAudio.play().catch(() => {});
    } catch {}
  }

  // playLandSound is no longer needed — the MP3 covers the full SFX.
  // Kept as no-op so call sites don't break.
  function playLandSound(_isHeads: boolean) {}

  // Cartoon "Boing-Boing" sound synthesis for Jelly Slime animation
  function playJellyBoingSound() {
    if (!state.soundEnabled) return;
    try {
      const AudioContextClass =
        window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioContextClass) return;
      const ctx = new AudioContextClass();
      const now = ctx.currentTime;

      // Bounce 1: Big Juicy Cartoon Boing
      const osc1 = ctx.createOscillator();
      const gain1 = ctx.createGain();
      osc1.type = "sine";
      osc1.frequency.setValueAtTime(140, now);
      osc1.frequency.exponentialRampToValueAtTime(560, now + 0.12);
      osc1.frequency.exponentialRampToValueAtTime(260, now + 0.25);
      gain1.gain.setValueAtTime(0.28, now);
      gain1.gain.exponentialRampToValueAtTime(0.01, now + 0.28);
      osc1.connect(gain1);
      gain1.connect(ctx.destination);
      osc1.start(now);
      osc1.stop(now + 0.3);

      // Bounce 2: Cute Rebound Micro-Boing
      const osc2 = ctx.createOscillator();
      const gain2 = ctx.createGain();
      osc2.type = "sine";
      const t2 = now + 0.26;
      osc2.frequency.setValueAtTime(240, t2);
      osc2.frequency.exponentialRampToValueAtTime(460, t2 + 0.08);
      osc2.frequency.exponentialRampToValueAtTime(310, t2 + 0.2);
      gain2.gain.setValueAtTime(0.18, t2);
      gain2.gain.exponentialRampToValueAtTime(0.01, t2 + 0.24);
      osc2.connect(gain2);
      gain2.connect(ctx.destination);
      osc2.start(t2);
      osc2.stop(t2 + 0.25);
    } catch {}
  }

  // Classic NES 8-bit Mario Coin Chime (B5 -> E6 square wave)
  function playMarioCoinSound() {
    if (!state.soundEnabled) return;
    try {
      const AudioContextClass =
        window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioContextClass) return;
      const ctx = new AudioContextClass();
      const now = ctx.currentTime;

      // Note 1: B5 (987.77 Hz)
      const osc1 = ctx.createOscillator();
      const gain1 = ctx.createGain();
      osc1.type = "square";
      osc1.frequency.setValueAtTime(987.77, now);
      gain1.gain.setValueAtTime(0.18, now);
      gain1.gain.setValueAtTime(0.18, now + 0.08);
      gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
      osc1.connect(gain1);
      gain1.connect(ctx.destination);
      osc1.start(now);
      osc1.stop(now + 0.095);

      // Note 2: E6 (1318.51 Hz) — classic high coin chime
      const osc2 = ctx.createOscillator();
      const gain2 = ctx.createGain();
      osc2.type = "square";
      const t2 = now + 0.09;
      osc2.frequency.setValueAtTime(1318.51, t2);
      gain2.gain.setValueAtTime(0.22, t2);
      gain2.gain.exponentialRampToValueAtTime(0.001, t2 + 0.38);
      osc2.connect(gain2);
      gain2.connect(ctx.destination);
      osc2.start(t2);
      osc2.stop(t2 + 0.4);
    } catch {}
  }

  // Mario Landing 8-bit Blip
  function playMarioLandSound() {
    if (!state.soundEnabled) return;
    try {
      const AudioContextClass =
        window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioContextClass) return;
      const ctx = new AudioContextClass();
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = "triangle";
      osc.frequency.setValueAtTime(380, now);
      osc.frequency.exponentialRampToValueAtTime(220, now + 0.12);
      gain.gain.setValueAtTime(0.2, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.14);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.15);
    } catch {}
  }

  // Spawn retro golden star sparkles around the coin
  function spawnMarioSparkles(targetEl: HTMLElement | null) {
    if (!targetEl) return;
    const stars = ["⭐", "✨", "✦", "⭐", "✨", "★"];
    const angles = [30, 90, 150, 210, 270, 330];

    angles.forEach((deg, idx) => {
      const star = document.createElement("div");
      star.className = "mario-sparkle";
      star.textContent = stars[idx % stars.length];

      const rad = (deg * Math.PI) / 180;
      const dist = 65 + Math.random() * 35;
      const dx = Math.cos(rad) * dist;
      const dy = Math.sin(rad) * dist - 35; // slightly upward bias

      star.style.left = "50%";
      star.style.top = "50%";
      star.style.setProperty("--dx", `${dx.toFixed(1)}px`);
      star.style.setProperty("--dy", `${dy.toFixed(1)}px`);

      targetEl.appendChild(star);
      setTimeout(() => star.remove(), 800);
    });
  }

  // Arcade Jackpot Ratchet Ticking Sound (Reel acceleration)
  function playJackpotReelSound() {
    if (!state.soundEnabled) return;
    try {
      const AudioContextClass =
        window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioContextClass) return;
      const ctx = new AudioContextClass();
      const now = ctx.currentTime;

      // Series of mechanical ratchet clicks (accelerating ticks)
      const clicks = [
        0, 0.05, 0.1, 0.16, 0.23, 0.31, 0.4, 0.5, 0.62, 0.75, 0.89, 1.0,
      ];
      clicks.forEach((delay, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "triangle";
        const pitch = 900 + (i % 3) * 150;
        osc.frequency.setValueAtTime(pitch, now + delay);

        gain.gain.setValueAtTime(0.12, now + delay);
        gain.gain.exponentialRampToValueAtTime(0.001, now + delay + 0.03);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now + delay);
        osc.stop(now + delay + 0.035);
      });
    } catch {}
  }

  // Casino Triumphant Jackpot Chime (Mechanical Latch + C6-E6-G6-C7 Arpeggio)
  function playJackpotWinSound() {
    if (!state.soundEnabled) return;
    try {
      const AudioContextClass =
        window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioContextClass) return;
      const ctx = new AudioContextClass();
      const now = ctx.currentTime;

      // 1. Heavy mechanical latch snap CLACK
      const latchOsc = ctx.createOscillator();
      const latchGain = ctx.createGain();
      latchOsc.type = "sawtooth";
      latchOsc.frequency.setValueAtTime(180, now);
      latchOsc.frequency.exponentialRampToValueAtTime(40, now + 0.08);
      latchGain.gain.setValueAtTime(0.35, now);
      latchGain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
      latchOsc.connect(latchGain);
      latchGain.connect(ctx.destination);
      latchOsc.start(now);
      latchOsc.stop(now + 0.095);

      // 2. Vegas Casino Triumphant Arpeggio: C6 -> E6 -> G6 -> C7
      const notes = [1046.5, 1318.5, 1568.0, 2093.0];
      notes.forEach((freq, idx) => {
        const t = now + 0.08 + idx * 0.07;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(freq, t);

        const isLast = idx === notes.length - 1;
        const dur = isLast ? 0.45 : 0.15;
        gain.gain.setValueAtTime(0.25, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + dur);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(t);
        osc.stop(t + dur + 0.02);
      });
    } catch {}
  }

