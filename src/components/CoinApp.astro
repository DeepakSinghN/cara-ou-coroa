  // ---------- Flip logic ----------
  // Shadow animation helper — runs on rAF during coin flight
  function animateShadow(shadowEl: HTMLElement, duration: number) {
    const start = performance.now();
    const isPopout = state.animStyle === "popout";
    const isJelly = state.animStyle === "jelly";
    const shrinkScale = isJelly ? 0.72 : 0.65;
    const shrinkOpacity = isJelly ? 0.76 : 0.7;
    function frame(now: number) {
      const t = Math.min((now - start) / duration, 1);
      const arc = Math.sin(t * Math.PI); // 0 → 1 → 0
      if (isPopout) {
        // In 3D pop-out: coin comes toward viewer/camera, so shadow expands wider and diffuses softly on background
        const scale = 1 + arc * 0.45;
        const opacity = 1 - arc * 0.65;
        shadowEl.style.transform = `scale(${scale.toFixed(3)})`;
        shadowEl.style.opacity = opacity.toFixed(3);
        shadowEl.style.filter = `blur(${(4 + arc * 8).toFixed(1)}px)`;
      } else {
        const scale = 1 - arc * shrinkScale;
        const opacity = 1 - arc * shrinkOpacity;
        shadowEl.style.transform = `scale(${scale.toFixed(3)})`;
        shadowEl.style.opacity = opacity.toFixed(3);
        shadowEl.style.filter = "blur(4px)";
      }
      if (t < 1) requestAnimationFrame(frame);
      else {
        shadowEl.style.transform = "scale(1)";
        shadowEl.style.opacity = "1";
        shadowEl.style.filter = "blur(4px)";
      }
    }
    requestAnimationFrame(frame);
  }

  function flipSingle(): Promise<"H" | "T"> {
    return new Promise((resolve) => {
      const coin =
        document.getElementById("single-coin") ||
        document.getElementById("coin-0");
      const wrapper = coin?.closest(".coin-wrapper") as HTMLElement | null;
      const shadow =
        document.getElementById("coin-0-shadow") ||
        document.getElementById("shadow-0");
      if (!coin) {
        resolve(Math.random() < 0.5 ? "H" : "T");
        return;
      }

      const result: "H" | "T" = Math.random() < 0.5 ? "H" : "T";
      coin.classList.remove("spinning", "landing-heads", "landing-tails");
      if (wrapper)
        wrapper.classList.remove("spinning", "landing-heads", "landing-tails");
      void (coin as HTMLElement).offsetWidth; // reflow

      const isPopout = state.animStyle === "popout";
      const isJackpot = state.animStyle === "jackpot";
      const isMario = state.animStyle === "mario";
      const isJelly = state.animStyle === "jelly";
      const spinDuration = isPopout
        ? 1400
        : isJackpot
          ? 1100
          : isMario
            ? 900
            : isJelly
              ? 1200
              : 800;
      const landDuration = isPopout
        ? 400
        : isJackpot
          ? 400
          : isMario
            ? 450
            : isJelly
              ? 750
              : 400;

      if (isJackpot) {
        playJackpotReelSound();
      } else if (isMario) {
        playMarioCoinSound();
        if (wrapper) spawnMarioSparkles(wrapper);
      } else {
        playFlipSound();
      }
      vibrate();

      if (shadow) animateShadow(shadow, spinDuration);
      coin.classList.add("spinning");
      if (wrapper) wrapper.classList.add("spinning");

      setTimeout(() => {
        coin.classList.remove("spinning");
        if (wrapper) wrapper.classList.remove("spinning");

        const landClass = result === "H" ? "landing-heads" : "landing-tails";
        coin.classList.add(landClass);
        if (wrapper) wrapper.classList.add(landClass);

        if (isJackpot) {
          playJackpotWinSound();
          if (wrapper) spawnJackpotRing(wrapper);
        } else if (isMario) {
          playMarioLandSound();
        } else if (isJelly) {
          playJellyBoingSound();
        } else {
          playLandSound(result === "H");
        }
        vibrate();
        setTimeout(() => resolve(result), landDuration);
      }, spinDuration);
    });
  }

  function flipMultiple(count: number): Promise<("H" | "T")[]> {
    return new Promise((resolve) => {
      const results: ("H" | "T")[] = Array.from({ length: count }, () =>
        Math.random() < 0.5 ? "H" : "T",
      );
      const coins = Array.from({ length: count }, (_, i) =>
        document.getElementById(`coin-${i}`),
      ).filter(Boolean) as HTMLElement[];

      const isPopout = state.animStyle === "popout";
      const isJackpot = state.animStyle === "jackpot";
      const isMario = state.animStyle === "mario";
      const isJelly = state.animStyle === "jelly";
      const spinDuration = isPopout
        ? 1400
        : isJackpot
          ? 1100
          : isMario
            ? 900
            : isJelly
              ? 1200
              : 800;
      const landDuration = isPopout
        ? 400
        : isJackpot
          ? 400
          : isMario
            ? 450
            : isJelly
              ? 750
              : 400;

      if (isJackpot) {
        playJackpotReelSound();
      } else if (isMario) {
        playMarioCoinSound();
      } else {
        playFlipSound();
      }
      vibrate();

      coins.forEach((coin) => {
        coin.classList.remove("spinning", "landing-heads", "landing-tails");
        coin
          .closest(".coin-wrapper")
          ?.classList.remove("spinning", "landing-heads", "landing-tails");
      });

      setTimeout(() => {
        coins.forEach((coin, i) => {
          const shadow = document.getElementById(`shadow-${i}`);
          const wrapper = coin.closest(".coin-wrapper") as HTMLElement | null;
          if (shadow) animateShadow(shadow, spinDuration);
          if (isMario && wrapper) spawnMarioSparkles(wrapper);
          coin.classList.add("spinning");
          if (wrapper) wrapper.classList.add("spinning");

          setTimeout(
            () => {
              coin.classList.remove("spinning");
              if (wrapper) wrapper.classList.remove("spinning");
              const landClass =
                results[i] === "H" ? "landing-heads" : "landing-tails";
              coin.classList.add(landClass);
              if (wrapper) wrapper.classList.add(landClass);
              if (isJackpot && wrapper) spawnJackpotRing(wrapper);
            },
            spinDuration + i * 35,
          );
        });

        setTimeout(
          () => {
            if (isJackpot) {
              playJackpotWinSound();
            } else if (isMario) {
              playMarioLandSound();
            } else if (isJelly) {
              playJellyBoingSound();
            } else {
              playLandSound(
                results.filter((r) => r === "H").length > results.length / 2,
              );
            }
            resolve(results);
          },
          spinDuration + count * 35 + landDuration,
        );
      }, 50);
    });
  }

  async function doFlip() {
    if (state.isFlipping) return;
    state.isFlipping = true;

    const flipBtn = document.getElementById("flip-btn") as HTMLButtonElement;
    flipBtn.disabled = true;
    flipBtn.textContent = "Jogando…";

    const resultText = document.getElementById("result-text")!;
    const resultSub = document.getElementById("result-sub")!;

    resultText.style.opacity = "0";
    resultSub.style.opacity = "0";

    const showcase = document.getElementById("winner-showcase");
    const readyState = document.getElementById("showcase-ready-state");
    const winnerState = document.getElementById("showcase-winner-state");
    const winnerBadgePill = document.getElementById("winner-badge-pill");
    const winnerIcon = document.getElementById("winner-icon");
    const winnerBadgeText = document.getElementById("winner-badge-text");
    const winnerTitle = document.getElementById("winner-title");
    const winnerSub = document.getElementById("winner-sub");

    if (state.coinCount === 1) {
      const result = await flipSingle();
      addResult(result);

      const isHeads = result === "H";
      const sideName = isHeads ? state.headsLabel : state.tailsLabel;
      resultText.textContent = sideName;
      const isDark =
        document.documentElement.getAttribute("data-theme") === "dark";
      resultText.style.color = isHeads
        ? isDark
          ? "#ffe680"
          : "#b8860b"
        : isDark
          ? "#ffffff"
          : "#1d1d1f";
      resultSub.textContent = `Caiu em ${sideName}`;

      resultText.style.opacity = "1";
      resultSub.style.opacity = "1";

      // Update Option A Live Winner Showcase
      if (showcase && readyState && winnerState && winnerTitle && winnerSub) {
        readyState.classList.add("hidden");
        winnerState.classList.remove("hidden");
        winnerState.classList.add("flex");

        if (isHeads) {
          showcase.className =
            "winner-showcase-heads rounded-xl p-4 border text-center transition-all duration-300";
          if (winnerIcon) winnerIcon.textContent = "👑";
          if (winnerBadgeText) winnerBadgeText.textContent = "Vencedor";
          if (winnerBadgePill)
            winnerBadgePill.className =
              "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-black tracking-wider uppercase mb-1 shadow-sm bg-[#d4a017]/25 text-[#734c00] dark:text-[#ffe680]";
          winnerTitle.textContent = state.headsLabel;
          winnerSub.textContent = `Caiu em ${state.headsLabel}!`;
        } else {
          showcase.className =
            "winner-showcase-tails rounded-xl p-4 border text-center transition-all duration-300";
          if (winnerIcon) winnerIcon.textContent = "⚡";
          if (winnerBadgeText) winnerBadgeText.textContent = "Vencedor";
          if (winnerBadgePill)
            winnerBadgePill.className =
              "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-black tracking-wider uppercase mb-1 shadow-sm bg-slate-500/20 text-slate-700 dark:text-slate-200";
          winnerTitle.textContent = state.tailsLabel;
          winnerSub.textContent = `Caiu em ${state.tailsLabel}!`;
        }
      }

      // Check Best-of winner
      if (state.bestofN > 0) {
        const target = Math.ceil(state.bestofN / 2);
        if (
          state.bestofHeadsWins >= target ||
          state.bestofTailsWins >= target
        ) {
          const winner =
            state.bestofHeadsWins >= target
              ? state.headsLabel
              : state.tailsLabel;
          setTimeout(() => triggerBestofWin(winner), 500);
        }
      }
    } else {
      const results = await flipMultiple(state.coinCount);
      results.forEach((r) => addResult(r));

      const hCount = results.filter((r) => r === "H").length;
      const tCount = results.length - hCount;

      resultText.textContent = `${hCount} Cara · ${tCount} Coroa`;
      const isDark =
        document.documentElement.getAttribute("data-theme") === "dark";
      resultText.style.color = isDark ? "#ffffff" : "#1d1d1f";
      resultSub.textContent = `${state.coinCount} moedas lançadas`;

      resultText.style.opacity = "1";
      resultSub.style.opacity = "1";

      // Update Option A Live Winner Showcase for multiple coins
      if (showcase && readyState && winnerState && winnerTitle && winnerSub) {
        readyState.classList.add("hidden");
        winnerState.classList.remove("hidden");
        winnerState.classList.add("flex");
        const majorityHeads = hCount >= tCount;
        showcase.className = majorityHeads
          ? "winner-showcase-heads rounded-xl p-4 border text-center transition-all duration-300"
          : "winner-showcase-tails rounded-xl p-4 border text-center transition-all duration-300";
        if (winnerIcon) winnerIcon.textContent = "🪙";
        if (winnerBadgeText) winnerBadgeText.textContent = "Resultado Múltiplo";
        if (winnerBadgePill)
          winnerBadgePill.className =
            "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-black tracking-wider uppercase mb-1 shadow-sm bg-black/10 dark:bg-white/10 text-ink dark:text-on-dark";
        winnerTitle.textContent = `${hCount} ${state.headsLabel} · ${tCount} ${state.tailsLabel}`;
        winnerSub.textContent = `${state.coinCount} moedas lançadas`;
      }
    }

    state.isFlipping = false;
    flipBtn.disabled = false;
    flipBtn.innerHTML = `
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="shrink-0">
      <path d="M1 4v6h6M23 20v-6h-6"/>
      <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4-4.64 4.36A9 9 0 0 1 3.51 15"/>
    </svg>
    Jogar a moeda!
  `;
  }

  // ---------- Confetti ----------
  function triggerConfetti() {
    const colors = ["#ffe680", "#d4a017", "#ffffff", "#0066cc", "#2997ff"];
    for (let i = 0; i < 60; i++) {
      const piece = document.createElement("div");
      piece.className = "confetti-piece";
      piece.style.left = `${Math.random() * 100}vw`;
      piece.style.top = "-10px";
      piece.style.backgroundColor =
        colors[Math.floor(Math.random() * colors.length)];
      piece.style.width = `${Math.random() * 10 + 6}px`;
      piece.style.height = `${Math.random() * 10 + 6}px`;
      piece.style.animationDuration = `${Math.random() * 2 + 1.5}s`;
      piece.style.animationDelay = `${Math.random() * 0.5}s`;
      document.body.appendChild(piece);
      setTimeout(() => piece.remove(), 3500);
    }
  }

  function triggerBestofWin(winnerName: string) {
    triggerConfetti();
    alert(`🏆 ${winnerName} Vence o Torneio Melhor de ${state.bestofN}!`);
    // Reset bestof score
    state.bestofHeadsWins = 0;
    state.bestofTailsWins = 0;
    updateStatsUI();
  }

  // ---------- Reset ----------
  function resetStats() {
    state.totalFlips = 0;
    state.headsCount = 0;
    state.tailsCount = 0;
    state.currentStreak = { side: "", count: 0 };
    state.longestStreak = { side: "", count: 0 };
    state.history = [];
    state.bestofHeadsWins = 0;
    state.bestofTailsWins = 0;

    const resultText = document.getElementById("result-text");
    const resultSub = document.getElementById("result-sub");
    if (resultText) {
      resultText.textContent = "";
      resultText.style.opacity = "0";
    }
    if (resultSub) {
      resultSub.textContent = "";
      resultSub.style.opacity = "0";
    }

    const showcase = document.getElementById("winner-showcase");
    const readyState = document.getElementById("showcase-ready-state");
    const winnerState = document.getElementById("showcase-winner-state");
    if (showcase && readyState && winnerState) {
      showcase.className =
        "winner-showcase-ready rounded-xl p-4 border text-center transition-all duration-300";
      readyState.classList.remove("hidden");
      winnerState.classList.add("hidden");
      winnerState.classList.remove("flex");
    }

    updateStatsUI();
  }

  // ---------- Event Listeners ----------
  document.addEventListener("DOMContentLoaded", () => {
    // Single coin click
    document
      .getElementById("single-coin")
      ?.addEventListener("click", () => doFlip());
    document
      .getElementById("flip-btn")
      ?.addEventListener("click", () => doFlip());
    document
      .getElementById("reset-btn")
      ?.addEventListener("click", () => resetStats());

    // Sound toggle
    const soundBtn = document.getElementById("sound-btn");
    const soundOnIcon = document.getElementById("sound-on-icon");
    const soundOffIcon = document.getElementById("sound-off-icon");

    soundBtn?.addEventListener("click", () => {
      state.soundEnabled = !state.soundEnabled;
      if (state.soundEnabled) {
        soundOnIcon?.classList.remove("hidden");
        soundOffIcon?.classList.add("hidden");
      } else {
        soundOnIcon?.classList.add("hidden");
        soundOffIcon?.classList.remove("hidden");
      }
    });

    // Window resize handler (re-adjust coin sizing when rotating mobile device)
    let resizeTimeout: any;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        renderCoins(state.coinCount);
      }, 150);
    });

    // Best-of select
    const bestofSelect = document.getElementById(
      "bestof-select",
    ) as HTMLSelectElement;
    bestofSelect?.addEventListener("change", () => {
      state.bestofN = parseInt(bestofSelect.value, 10);
      state.bestofHeadsWins = 0;
      state.bestofTailsWins = 0;
      updateStatsUI();
    });

    // Animation style select (Pop-Out vs Jackpot vs Mario vs Jelly Slime vs Classic)
    const animStyleSelect = document.getElementById(
      "anim-style-select",
    ) as HTMLSelectElement;
    animStyleSelect?.addEventListener("change", () => {
      state.animStyle = animStyleSelect.value;
      const container = document.getElementById("coins-container");
      if (container) {
        container.classList.toggle(
          "style-popout",
          state.animStyle === "popout",
        );
        container.classList.toggle(
          "style-jackpot",
          state.animStyle === "jackpot",
        );
        container.classList.toggle("style-mario", state.animStyle === "mario");
        container.classList.toggle("style-jelly", state.animStyle === "jelly");
      }
    });

    // Customize modal
    const modal = document.getElementById("customize-modal")!;
    const customizeBtn = document.getElementById("customize-btn");
    const cancelBtn = document.getElementById("customize-cancel");
    const saveBtn = document.getElementById("customize-save");
    const inputHeads = document.getElementById(
      "custom-heads",
    ) as HTMLInputElement;
    const inputTails = document.getElementById(
      "custom-tails",
    ) as HTMLInputElement;

    customizeBtn?.addEventListener("click", () => {
      inputHeads.value = state.headsLabel;
      inputTails.value = state.tailsLabel;
      modal.classList.add("open");
    });

    cancelBtn?.addEventListener("click", () => modal.classList.remove("open"));
    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.classList.remove("open");
    });

    saveBtn?.addEventListener("click", () => {
      const h = inputHeads.value.trim();
      const t = inputTails.value.trim();
      if (h) state.headsLabel = h;
      if (t) state.tailsLabel = t;
      updateCoinLabelsOnCoins();
      updateStatsUI();
      modal.classList.remove("open");
    });

    // Keyboard shortcuts
    document.addEventListener("keydown", (e) => {
      // Ignore if input is focused
      if (
        ["INPUT", "TEXTAREA", "SELECT"].includes(
          (e.target as HTMLElement).tagName,
        )
      )
        return;
      if (modal.classList.contains("open")) return;

      if (e.code === "Space") {
        e.preventDefault();
        doFlip();
      } else if (e.code === "KeyR") {
        resetStats();
      }
    });
  });
</script>
