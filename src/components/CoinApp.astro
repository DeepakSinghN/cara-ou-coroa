  // ---------- Stats update ----------
  function addResult(side: "H" | "T") {
    state.totalFlips++;
    if (side === "H") state.headsCount++;
    else state.tailsCount++;

    // Streak
    if (state.currentStreak.side === side) {
      state.currentStreak.count++;
    } else {
      state.currentStreak = { side, count: 1 };
    }

    if (state.currentStreak.count > state.longestStreak.count) {
      state.longestStreak = { ...state.currentStreak };
    }

    // History (last 30)
    state.history.unshift(side);
    if (state.history.length > 30) state.history.pop();

    // Best-of tracking
    if (state.bestofN > 0) {
      if (side === "H") state.bestofHeadsWins++;
      else state.bestofTailsWins++;
    }

    updateStatsUI();
  }

  function updateStatsUI() {
    const getSideLabel = (s: string) =>
      s === "H" ? state.headsLabel : s === "T" ? state.tailsLabel : "—";

    // Total
    const totalEl = document.getElementById("stat-total");
    if (totalEl) totalEl.textContent = state.totalFlips.toString();

    // Side Labels in Stats Panel
    const headsNameEl = document.getElementById("stat-heads-name");
    const tailsNameEl = document.getElementById("stat-tails-name");
    if (headsNameEl) headsNameEl.textContent = state.headsLabel;
    if (tailsNameEl) tailsNameEl.textContent = state.tailsLabel;

    // Counts & %
    const headsEl = document.getElementById("stat-heads");
    const headsPctEl = document.getElementById("stat-heads-pct");
    const tailsEl = document.getElementById("stat-tails");
    const tailsPctEl = document.getElementById("stat-tails-pct");

    const headsPct = state.totalFlips
      ? Math.round((state.headsCount / state.totalFlips) * 100)
      : 0;
    const tailsPct = state.totalFlips
      ? Math.round((state.tailsCount / state.totalFlips) * 100)
      : 0;

    if (headsEl) headsEl.textContent = state.headsCount.toString();
    if (headsPctEl) headsPctEl.textContent = headsPct.toString();
    if (tailsEl) tailsEl.textContent = state.tailsCount.toString();
    if (tailsPctEl) tailsPctEl.textContent = tailsPct.toString();

    // Head-to-Head Dual Split Bar
    const barHeads = document.getElementById("bar-heads");
    const barTails = document.getElementById("bar-tails");
    if (barHeads && barTails) {
      if (state.totalFlips === 0) {
        barHeads.style.width = "50%";
        barTails.style.width = "50%";
      } else {
        barHeads.style.width = `${headsPct}%`;
        barTails.style.width = `${tailsPct}%`;
      }
    }

    // Streak Banner Indicator (Option A)
    const streakBanner = document.getElementById("streak-banner");
    const streakBannerText = document.getElementById("streak-banner-text");
    if (streakBanner && streakBannerText) {
      if (state.currentStreak.count >= 2) {
        streakBanner.classList.remove("hidden");
        streakBanner.classList.add("flex");
        streakBannerText.textContent = `${state.currentStreak.count}x Seguidas de ${getSideLabel(state.currentStreak.side)}!`;
      } else {
        streakBanner.classList.add("hidden");
        streakBanner.classList.remove("flex");
      }
    }

    // Longest Streak Record
    const longestDisplay = document.getElementById("stat-longest-display");
    if (longestDisplay) {
      longestDisplay.innerHTML =
        state.longestStreak.count > 0
          ? `Recorde: <strong class="text-ink dark:text-on-dark font-semibold">${state.longestStreak.count}x ${getSideLabel(state.longestStreak.side)}</strong>`
          : `Recorde: <strong>—</strong>`;
    }

    // Best-of UI
    const bestofContainer = document.getElementById("bestof-score-container");
    if (bestofContainer) {
      if (state.bestofN > 0) {
        bestofContainer.classList.remove("hidden");
        bestofContainer.style.display = "flex";
        const label = document.getElementById("bestof-label");
        if (label) label.textContent = `Melhor de ${state.bestofN}`;

        const headsWinsEl = document.getElementById("bestof-heads-wins");
        const tailsWinsEl = document.getElementById("bestof-tails-wins");
        if (headsWinsEl)
          headsWinsEl.textContent = state.bestofHeadsWins.toString();
        if (tailsWinsEl)
          tailsWinsEl.textContent = state.bestofTailsWins.toString();
      } else {
        bestofContainer.classList.add("hidden");
        bestofContainer.style.display = "none";
      }
    }

    // History stream (Mini Minted 3D Tokens)
    const historyStream = document.getElementById("history-stream");
    const historyEmpty = document.getElementById("history-empty");
    const historyCount = document.getElementById("history-count");

    if (historyStream && historyEmpty) {
      if (state.history.length === 0) {
        historyEmpty.classList.remove("hidden");
        historyStream.innerHTML = "";
        if (historyCount) historyCount.textContent = "";
      } else {
        historyEmpty.classList.add("hidden");
        if (historyCount)
          historyCount.textContent = `(${state.history.length})`;
        const getCoinSymbol = (side: string) => {
          if (side === "H") {
            return state.headsLabel === "Cara"
              ? "C"
              : state.headsLabel.slice(0, 1).toUpperCase();
          } else {
            return state.tailsLabel === "Coroa"
              ? "K"
              : state.tailsLabel.slice(0, 1).toUpperCase();
          }
        };
        historyStream.innerHTML = state.history
          .slice(0, 18)
          .map(
            (s, idx) => `
        <span class="history-coin ${s === "H" ? "heads" : "tails"}" title="#${state.history.length - idx}: ${getSideLabel(s)}">${getCoinSymbol(s)}</span>
      `,
          )
          .join("");
      }
    }
  }

