---
// Rodapé — cara ou coroa virtual
---
<footer class="bg-parchment text-ink-muted py-16 pb-8">
  <div class="container-content">
    <!-- Colunas de links -->
    <div class="grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-10 mb-12">
      <!-- Coluna da marca -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <img src="/favicon.svg" width="20" height="20" alt="Logo Cara ou Coroa Virtual" class="w-5 h-5 object-contain" />
          <span class="text-sm font-semibold text-ink">Cara ou Coroa Virtual</span>
        </div>
        <p class="text-xs leading-relaxed m-0 text-ink-faint">
          Cara ou coroa online grátis. Sem cadastro, sem rastreamento, sem anúncios. Só jogar.
        </p>
      </div>

      <!-- Coluna de recursos -->
      <div>
        <h3 class="text-sm font-semibold text-ink mb-3 mt-0">Recursos</h3>
        <ul class="list-none m-0 p-0 flex flex-col">
          <li><a href="/#cara-ou-coroa" class="text-sm text-ink-muted hover:text-primary transition-colors leading-[2.41] block">Jogar Cara ou Coroa</a></li>
          <li><a href="/#cara-ou-coroa" class="text-sm text-ink-muted hover:text-primary transition-colors leading-[2.41] block">Modo Multi-Moeda</a></li>
          <li><a href="/#cara-ou-coroa" class="text-sm text-ink-muted hover:text-primary transition-colors leading-[2.41] block">Rótulos Personalizados</a></li>
          <li><a href="/#cara-ou-coroa" class="text-sm text-ink-muted hover:text-primary transition-colors leading-[2.41] block">Modo Melhor de 3/5</a></li>
        </ul>
      </div>

      <!-- Coluna de informações -->
      <div>
        <h3 class="text-sm font-semibold text-ink mb-3 mt-0">Informações</h3>
        <ul class="list-none m-0 p-0 flex flex-col">
          <li><a href="/#como-funciona" class="text-sm text-ink-muted hover:text-primary transition-colors leading-[2.41] block">Como Funciona</a></li>
          <li><a href="/#perguntas-frequentes" class="text-sm text-ink-muted hover:text-primary transition-colors leading-[2.41] block">Perguntas Frequentes</a></li>
          <li><a href="/#casos-de-uso" class="text-sm text-ink-muted hover:text-primary transition-colors leading-[2.41] block">Quando Usar</a></li>
          <li><a href="/sobre-nos" class="text-sm text-ink-muted hover:text-primary transition-colors leading-[2.41] block">Sobre Nós</a></li>
        </ul>
      </div>

      <!-- Coluna legal -->
      <div>
        <h3 class="text-sm font-semibold text-ink mb-3 mt-0">Legal & Contato</h3>
        <ul class="list-none m-0 p-0 flex flex-col">
          <li><a href="/contato" class="text-sm text-ink-muted hover:text-primary transition-colors leading-[2.41] block">Fale Conosco</a></li>
          <li><a href="/politica-de-privacidade" class="text-sm text-ink-muted hover:text-primary transition-colors leading-[2.41] block">Política de Privacidade</a></li>
          <li><a href="/termos-e-condicoes" class="text-sm text-ink-muted hover:text-primary transition-colors leading-[2.41] block">Termos e Condições</a></li>
        </ul>
      </div>
    </div>

    <!-- Divisor e rodapé -->
    <div class="border-t border-hairline pt-6 flex flex-wrap justify-between items-center gap-3">
      <p class="text-xs text-ink-faint m-0">
        &copy; {new Date().getFullYear()} Cara ou Coroa Virtual — caraoucoroavirtual.com. Uso gratuito para sempre.
      </p>
      <p class="text-xs text-ink-faint m-0">
        Nenhum dado é coletado ou armazenado. Jogue à vontade.
      </p>
    </div>
  </div>
</footer>
