---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  ogImage?: string;
  schemas?: Record<string, any>[];
  googleSiteVerification?: string;
}

const {
  title = "Cara ou Coroa Online — Simulador de Moeda Virtual Grátis",
  description = "Jogue cara ou coroa online com moeda 3D realista, estatísticas ao vivo e modo multi-moedas. Grátis, sem anúncios e sem cadastro. Tire a sua sorte agora!",
  canonicalUrl = "https://caraoucoroavirtual.com/",
  noindex = false,
  ogImage = "https://caraoucoroavirtual.com/og-image.jpg",
  schemas = [],
  googleSiteVerification = "",
} = Astro.props;

// Base WebSite Schema for consistent brand and indexing signals
const defaultWebsiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Cara ou Coroa Virtual",
  "alternateName": ["Cara ou Coroa Online", "Cara ou Corôa Jogo", "Moeda Virtual"],
  "url": "https://caraoucoroavirtual.com/",
  "inLanguage": "pt-BR",
  "description": "Simulador de cara ou coroa online grátis com moeda virtual em animação 3D.",
  "publisher": {
    "@type": "Organization",
    "name": "Cara ou Coroa Virtual",
    "url": "https://caraoucoroavirtual.com/",
    "logo": "https://caraoucoroavirtual.com/favicon-96x96.png"
  }
};

const allSchemas = [defaultWebsiteSchema, ...schemas];
---
<!doctype html>
<html lang="pt-BR" data-theme="light">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-F3T64ZPRH0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-F3T64ZPRH0');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Search Console verification (optional meta tag) -->
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Cara ou Coroa Virtual" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <meta name="keywords" content="cara ou coroa, cara ou coroa online, cara ou coroa no google, cara ou corôa jogo, google cara ou coroa, cara ou corôa jogar, cara ou corôa virtual, cara ou corôa moeda, jogar cara ou coroa, moeda virtual" />
    <meta name="language" content="Portuguese" />
    <meta name="geo.region" content="BR" />
    <meta name="geo.placename" content="Brasil" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Cara ou Coroa Virtual" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cara ou Coroa Virtual — Simulador 3D de Moeda Online" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Performance & Resource Hints -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preload" href="/coin-toss-sound.mp3" as="audio" type="audio/mpeg" />

    <!-- JSON-LD Structured Data -->
    {allSchemas.map((schemaObj) => (
      <script type="application/ld+json" set:html={JSON.stringify(schemaObj)} />
    ))}
  </head>
  <body>
    <!-- Tema claro por padrão — sem FOUC -->
    <script is:inline>
      document.documentElement.setAttribute('data-theme', 'light');
    </script>
    <slot />
  </body>
</html>
