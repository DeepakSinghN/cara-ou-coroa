---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contato — Cara ou Coroa Virtual"
  description="Entre em contato com a equipe do Cara ou Coroa Virtual. Dúvidas, sugestões ou feedback sobre o simulador de cara ou coroa online."
  canonicalUrl="https://caraoucoroavirtual.com/contato"
>
  <Nav />

  <main class="bg-canvas dark:bg-surface-black min-h-[100svh] pt-16">
    <!-- Page Hero -->
    <section class="tile-dark tile-padding py-16">
      <div class="container-content max-w-[760px] mx-auto text-center">
        <p class="text-sm font-semibold tracking-[0.231px] text-primary-dark mb-3 uppercase">Fale Conosco</p>
        <h1 class="text-display-lg text-on-dark mb-4 mt-0">Entre em Contato</h1>
        <p class="text-lead text-body-muted m-0 max-w-[500px] mx-auto">Tem uma dúvida, sugestão ou encontrou um problema? Adoraríamos ouvir você.</p>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="tile-light tile-padding">
      <div class="container-content max-w-[640px] mx-auto text-center space-y-10">

        <!-- Email Card -->
        <div class="bg-parchment border border-hairline rounded-2xl p-10 flex flex-col items-center gap-5">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-primary" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-ink-faint uppercase tracking-wider mb-2">E-mail</p>
            <a
              href="mailto:lifeturningpoint007@gmail.com"
              class="text-xl font-semibold text-primary hover:text-primary-focus transition-colors no-underline break-all"
              aria-label="Enviar e-mail para lifeturningpoint007@gmail.com"
            >
              lifeturningpoint007@gmail.com
            </a>
          </div>
          <p class="text-sm text-ink-faint m-0">Respondemos em até 2–3 dias úteis. Atendemos em Português e Inglês.</p>
          <a
            href="mailto:lifeturningpoint007@gmail.com"
            class="bg-primary text-white no-underline rounded-full font-semibold hover:bg-primary-focus transition-colors px-8 py-3 text-sm inline-block"
          >
            Enviar E-mail
          </a>
        </div>

        <!-- Info cards -->
        <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-5 text-left">
          <div class="bg-canvas border border-hairline rounded-xl p-5">
            <div class="text-2xl mb-3">⏱️</div>
            <h3 class="text-sm font-semibold text-ink mb-1 mt-0">Tempo de Resposta</h3>
            <p class="text-xs text-ink-faint m-0 leading-relaxed">Respondemos em até 2–3 dias úteis.</p>
          </div>
          <div class="bg-canvas border border-hairline rounded-xl p-5">
            <div class="text-2xl mb-3">💬</div>
            <h3 class="text-sm font-semibold text-ink mb-1 mt-0">Idiomas</h3>
            <p class="text-xs text-ink-faint m-0 leading-relaxed">Português (PT-BR) e Inglês.</p>
          </div>
          <div class="bg-canvas border border-hairline rounded-xl p-5">
            <div class="text-2xl mb-3">❓</div>
            <h3 class="text-sm font-semibold text-ink mb-1 mt-0">Verifique o FAQ</h3>
            <p class="text-xs text-ink-faint m-0 leading-relaxed">Muitas dúvidas já estão respondidas. <a href="/#perguntas-frequentes" class="text-primary hover:underline">Ver FAQ →</a></p>
          </div>
        </div>

        <!-- Legal links -->
        <div class="border-t border-hairline pt-8 flex flex-wrap justify-center gap-5">
          <a href="/politica-de-privacidade" class="text-sm text-ink-muted hover:text-primary transition-colors">Política de Privacidade</a>
          <span class="text-ink-faint/40">·</span>
          <a href="/termos-e-condicoes" class="text-sm text-ink-muted hover:text-primary transition-colors">Termos e Condições</a>
          <span class="text-ink-faint/40">·</span>
          <a href="/sobre-nos" class="text-sm text-ink-muted hover:text-primary transition-colors">Sobre Nós</a>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>
